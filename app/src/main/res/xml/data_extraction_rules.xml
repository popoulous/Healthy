<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app holds may leave the device — not to a cloud backup, and not
  to another phone during device transfer. The app stores only preferences
  anyway; the health data itself lives in Health Connect. Being explicit here
  costs nothing and keeps the promise checkable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
