    <string name="onboarding_permissions_title">Hozzáférés</string>
    <string name="onboarding_permissions_body">A Health Connect fogja megkérdezni, melyikhez férhet hozzá a Healthy. Engedélyezhetsz néhányat és megtagadhatsz másokat — amit megtagadsz, az egyszerűen lemarad a dashboardról.</string>
    <string name="onboarding_permissions_history">Ez a telefon a 30 napnál régebbi adatokhoz is tud hozzáférést adni. Enélkül a Healthy csak az elmúlt egy hónapot látja abból, amit az órád vagy a mérleged írt.</string>
    <string name="onboarding_permissions_history_unsupported">Ezen a telefonon a Health Connect nem tud 30 napnál régebbi adathoz hozzáférést adni, így a Healthy csak az elmúlt egy hónapot mutatja.</string>
    <string name="onboarding_grant">Engedélyek megadása</string>
    <string name="onboarding_back">Vissza</string>

